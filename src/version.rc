#include <winres.h>

#include "version.h"

1 VERSIONINFO
FILEVERSION UNVOICE_VERSION_MAJOR, UNVOICE_VERSION_MINOR, UNVOICE_VERSION_PATCH, 0
PRODUCTVERSION UNVOICE_VERSION_MAJOR, UNVOICE_VERSION_MINOR, UNVOICE_VERSION_PATCH, 0
FILEFLAGSMASK 0x17L
FILEFLAGS 0x0L
FILEOS 0x4L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Treats the voice lines of listed plugins as unvoiced"
            VALUE "FileVersion", UNVOICE_VERSION_STRING
            VALUE "InternalName", "Unvoice"
            VALUE "LegalCopyright", "Maeyanie | 0BSD License"
            VALUE "ProductName", "Unvoice"
            VALUE "ProductVersion", UNVOICE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
